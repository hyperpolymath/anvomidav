// Conformance: invalid/err_invalid_rotation.anv
// Purpose: Invalid jump rotation (quintuple does not exist)
// Expected Error: Lexical or parse error - unknown rotation

program invalid_rotation {
    segment sp: short {
        sequence elements {
            jump quintuple axel
        }
    }
}
