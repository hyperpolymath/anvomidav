// Conformance: valid/ice_dance_minimal.anv
// Purpose: Minimal valid ice dance program (only single jumps allowed)
// Expected: Parses and validates without errors

program ice_dance_test {
    segment rd: rhythm {
        sequence pattern_dance {
            pattern waltz
        }

        sequence steps {
            step serpentine L4
        }

        sequence spin_elem {
            spin upright L3
        }

        sequence choreo {
            choreographic spiral
        }
    }
}
