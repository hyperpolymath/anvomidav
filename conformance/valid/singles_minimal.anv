// Conformance: valid/singles_minimal.anv
// Purpose: Minimal valid singles short program
// Expected: Parses and validates without errors

program singles_test {
    segment sp: short {
        sequence elements {
            jump triple axel
            spin camel L3
            step circular L4
        }
    }
}
